{
  "_comment": "HACS 一 repo 只能一個整合；此表驅動 .github/workflows/hacs-dist-sync.yml 把各整合同步到獨立發佈 repo。新增整合請在此加一列並先建立對應的空 repo。",
  "targets": [
    {
      "src": "climate_template",
      "domain": "climate_template",
      "repo": "WOOWTECH/hacs-climate_template",
      "name": "Woow Climate Template"
    },
    {
      "src": "template_light_composer",
      "domain": "template_light_composer",
      "repo": "WOOWTECH/hacs-template_light_composer",
      "name": "Woow Template Light Composer"
    },
    {
      "src": "woow_cover_entity",
      "domain": "woow_cover_entity",
      "repo": "WOOWTECH/hacs-woow_cover_entity",
      "name": "Woow Cover Entity"
    },
    {
      "src": "woow_fan_entity",
      "domain": "woow_fan_entity",
      "repo": "WOOWTECH/hacs-woow_fan_entity",
      "name": "Woow Fan Entity"
    }
  ]
}
